# Base image
# The MapColonies nginx base image the gateway is built FROM.
# Replace with the real registry host/tag, e.g. <registry>/common/nginx:<tag>
NGINX_BASE_IMAGE=

# S3
S3_BUCKET_NAME=s3-example
S3_SERVER=minio
S3_SERVER_PORT=9000
S3_SERVER_PROTO=http
S3_REGION=us-east-1
S3_STYLE=path
ALLOW_DIRECTORY_LIST=true
AWS_SIGS_VERSION=4
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Nginx
CORS_ENABLED=true
NGINX_WORKER_PROCESSES=4
